[
  {
    "key": "homeassistant.url",
    "defaultValue": "",
    "description": {
      "zh": "Home Assistant 服务地址（如 http://192.168.1.100:8123）",
      "en": "Home Assistant service URL (e.g. http://192.168.1.100:8123)"
    },
    "type": "string",
    "manualOnly": true
  },
  {
    "key": "homeassistant.token",
    "defaultValue": "",
    "description": {
      "zh": "Home Assistant 长期访问令牌 Long-Lived Access Token",
      "en": "Home Assistant Long-Lived Access Token"
    },
    "type": "string",
    "uiHint": "password",
    "manualOnly": true
  },
  {
    "key": "homeassistant.allowControl",
    "defaultValue": false,
    "description": {
      "zh": "允许智能体调用设备控制服务 (关闭时为安全只读模式，仅允许查询状态)",
      "en": "Allow agent to call device control services (safe read-only mode when disabled, query states only)"
    },
    "type": "boolean",
    "manualOnly": true
  },
  {
    "key": "homeassistant.controlLevel",
    "defaultValue": "standard",
    "description": {
      "zh": "设备控制权限等级。提升权限级别会增加安全风险，请遵循最小权限原则，仅在必要时开放。",
      "en": "Control permission level. Elevating privileges increases security risks. Follow the principle of least privilege."
    },
    "type": "string",
    "uiHint": "select",
    "enumValues": [
      {
        "value": "standard",
        "label": {
          "zh": "常规控制 (家电与场景)",
          "en": "Standard (Appliances & Scenes)"
        }
      },
      {
        "value": "high_risk",
        "label": {
          "zh": "高危控制 (含门锁/阀门/警报)",
          "en": "High Risk (Locks, Valves, Sirens)"
        }
      },
      {
        "value": "system",
        "label": {
          "zh": "系统管理 (最高权限/完全访问)",
          "en": "System (Highest / Full Access)"
        }
      }
    ],
    "manualOnly": true,
    "showWhen": "homeassistant.allowControl"
  }
]
